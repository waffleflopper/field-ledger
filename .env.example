# Field Ledger local development
#
# These values target the local Supabase stack defined in supabase/config.toml.
# The ports intentionally avoid Supabase CLI defaults so another local Supabase
# project can keep running on 54320-54329.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key-from-pnpm-supabase-status

# Temporary Phase 1 local scaffold default. This is privileged and must be
# replaced with an app runtime role before additional account-owned tables land.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

SUPABASE_STUDIO_URL=http://127.0.0.1:54333
SUPABASE_INBUCKET_URL=http://127.0.0.1:54334
